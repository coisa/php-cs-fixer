{
    "name": "coisa/php-cs-fixer",
    "description": "Custom PHP CS Fixer Config",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentor.dev.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "friendsofphp/php-cs-fixer": "^3.95.25"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "CoiSA\\PhpCsFixer\\": "src"
        }
    },
    "scripts": {
        "check": ["@test", "@cs-check"],
        "test": "@php tests/run.php",
        "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs-fix": "php-cs-fixer fix"
    }
}
