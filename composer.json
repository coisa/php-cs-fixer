{
    "name": "coisa/php-cs-fixer",
    "description": "Custom PHP CS Fixer Config",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Felipe Sayão Lobato Abreu",
            "email": "github@mentor.dev.br"
        }
    ],
    "require": {
        "php": "^8.3",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "CoiSA\\PhpCsFixer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoiSA\\PhpCsFixer\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": ["@test", "@cs-check"],
        "test": "phpunit --configuration phpunit.xml.dist",
        "cs-check": "php-cs-fixer fix --dry-run --diff --using-cache=no",
        "cs-fix": "php-cs-fixer fix"
    }
}
